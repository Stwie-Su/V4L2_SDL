{
  "version": 4,
  "configurations": [
    {
      "name": "Linux (GCC)",
      // 编译数据库：包含每个源文件的 -I / -D / -std，索引结果与真实构建一致
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      // 编译数据库还没生成时的兜底头文件路径
      "includePath": [
        "${workspaceFolder}/src"
      ],
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "c11",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ]
}
