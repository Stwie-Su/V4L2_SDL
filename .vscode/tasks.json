{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: 配置",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-B",
        "build",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: 构建",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "-j"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: 配置",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "运行: v4l2_probe",
      "type": "shell",
      "command": "./build/v4l2_probe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: 构建",
      "problemMatcher": []
    },
    {
      "label": "运行: v4l2_display",
      "type": "shell",
      "command": "./build/v4l2_display",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: 构建",
      "problemMatcher": []
    }
  ]
}
